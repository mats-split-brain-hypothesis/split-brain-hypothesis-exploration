+"""Steering round 3: task-elicited control contrasts (no metacognitive instructions).
+
+E5 inclusion-vs-avoidance: paired sentences about the same carrier topic. A = a sentence
+   that must include the target concept; B = a sentence that must avoid it. The model
+   engages the target in both (use it / actively exclude it - the white-bear monitoring)
+   and the contrast is the *polarity of engagement in the writing task*, elicited by the
+   task's content constraint rather than by a "think / don't think" instruction.
+
+E2 diverse-target instruction contrast (robustness / target-type check): my own
+   think / don't-think pairs over concepts, numbers and words.
+
+Usage:
+    .venv/bin/python experiments/steer_r3.py capture
+    .venv/bin/python experiments/steer_r3.py build
+"""
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "out" / "steer"
+LAYERS = [19, 20, 21, 22, 23, 24]
+BAND = [20, 21, 22, 23, 24]
+TARGET = 20.0
+
+# (concept, include_sentence, avoid_sentence): same carrier, A includes the concept, B avoids it.
+E5 = [
+    ("volcano", "The volcano made the weather strange that day, with ash drifting through the air.",
+     "The weather was strange that day, with grey dust drifting through the air."),
+    ("ocean", "She could see the ocean from the top of the cliff, glittering in the sun.",
+     "She could see the water from the top of the cliff, glittering in the sun."),
+    ("chess", "He set up the chess board after dinner and moved the first piece.",
+     "He set up the game after dinner and moved the first piece."),
+    ("piano", "The piano stood in the corner of the hall, its lid propped open.",
+     "The instrument stood in the corner of the hall, its lid propped open."),
+    ("wolf", "A wolf howled somewhere beyond the trees as the campers fell asleep.",
+     "A dog howled somewhere beyond the trees as the campers fell asleep."),
+    ("river", "The river ran brown and quick after the rain, washing silt onto the banks.",
+     "The water ran brown and quick after the rain, washing silt onto the banks."),
+    ("candle", "She lit the candle and the kitchen filled with a soft, warm glow.",
+     "She lit the lamp and the kitchen filled with a soft, warm glow."),
+    ("storm", "The storm rolled in from the west and flattened the young grass in the field.",
+     "The rain rolled in from the west and flattened the young grass in the field."),
+    ("bridge", "The old bridge creaked as the cart crossed, its cables straining in the wind.",
+     "The span creaked as the cart crossed, its cables straining in the wind."),
