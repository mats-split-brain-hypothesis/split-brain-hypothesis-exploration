+    return {"cap_e5": e5, "cap_e2": e2}
+
+
+def capture() -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    for name, plist in prompts().items():
+        out_path = OUT / f"{name}.pt"
+        if out_path.exists():
+            print(f"{name}: exists, skip")
+            continue
+        spec = {"layers": LAYERS, "prompts": plist, "positions": "last", "per_prompt": True}
+        (OUT / f"{name}.spec.json").write_text(json.dumps(spec))
+        print(f"{name}: {len(plist)} prompts x {len(LAYERS)} layers", flush=True)
+        subprocess.run([sys.executable, str(ROOT / "tools" / "metric.py"), "capture",
+                        str(OUT / f"{name}.spec.json"), "--out", str(out_path)], check=True)
+
+
+def build() -> None:
+    tc = torch.load(OUT / "cap_dm_think.pt", weights_only=False)["mean"]
+    dc = torch.load(OUT / "cap_dm_dont.pt", weights_only=False)["mean"]
+    u = {L: tc[L] - dc[L] for L in LAYERS}
+
+    e5 = torch.load(OUT / "cap_e5.pt", weights_only=False)
+    incl = {L: e5["per_prompt"][L][0::2].mean(0) for L in LAYERS}
+    avoid = {L: e5["per_prompt"][L][1::2].mean(0) for L in LAYERS}
+    e5d = {L: incl[L] - avoid[L] for L in LAYERS}
+
+    e2 = torch.load(OUT / "cap_e2.pt", weights_only=False)
+    think = {L: e2["per_prompt"][L][0::2].mean(0) for L in LAYERS}
+    dont = {L: e2["per_prompt"][L][1::2].mean(0) for L in LAYERS}
+    e2d = {L: think[L] - dont[L] for L in LAYERS}
+
+    for name, d in {"v12_inclavoid": e5d, "v13_diverse": e2d}.items():
+        norms = {L: d[L].norm().item() for L in LAYERS}
+        c = [round(float(d[L] @ u[L] / (d[L].norm() * u[L].norm())), 3) for L in LAYERS]
+        print(name, "norms:", {L: round(norms[L], 2) for L in LAYERS}, "cos vs u:", c)
+        step = TARGET / sum(norms[L] for L in BAND)
+        torch.save({L: step * d[L] for L in BAND}, OUT / f"vecs_{name}.pt")
+
+
+if __name__ == "__main__":
+    capture() if len(sys.argv) > 1 and sys.argv[1] == "capture" else build()
