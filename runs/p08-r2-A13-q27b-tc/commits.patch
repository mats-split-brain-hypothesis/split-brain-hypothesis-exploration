+"""Thin driver over ``tools/metric.py run``: score one or more vector files, log results.
+
+Usage:
+    .venv/bin/python experiments/steer_run.py out/steer/vecs_v0_wbs.pt --scale 1.0 [--positions prefix]
+    .venv/bin/python experiments/steer_run.py a.pt b.pt --scale 1.0
+"""
+
+import argparse
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+LOG = ROOT / "out" / "steer" / "runs.jsonl"
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("vectors", nargs="+")
+    ap.add_argument("--scale", type=float, default=1.0)
+    ap.add_argument("--positions", default="prefix", choices=("prefix", "read", "context"))
+    args = ap.parse_args()
+    LOG.parent.mkdir(parents=True, exist_ok=True)
+    for v in args.vectors:
+        name = Path(v).stem
+        t0 = time.time()
+        r = subprocess.run(
+            [sys.executable, str(ROOT / "tools" / "metric.py"), "run", v, "--positions", args.positions, "--scale", str(args.scale)],
+            capture_output=True, text=True,
+        )
+        dt = time.time() - t0
+        try:
+            out = json.loads(r.stdout)
+        except Exception:
+            out = {"error": r.stdout[-500:] + r.stderr[-500:]}
+        rec = {"vec": name, "scale": args.scale, "positions": args.positions, "dt_s": round(dt, 1), **out}
+        with open(LOG, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+        print(json.dumps(rec, indent=1), flush=True)
+
+
+if __name__ == "__main__":
+    main()
