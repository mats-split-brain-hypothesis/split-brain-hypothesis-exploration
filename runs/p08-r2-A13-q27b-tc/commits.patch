+    ("market", "The market smelled of cinnamon and fresh bread before the crowds arrived.",
+     "The square smelled of cinnamon and fresh bread before the crowds arrived."),
+    ("school", "The school bell rang and the yard filled with shoes and shouted names.",
+     "The bell rang and the yard filled with shoes and shouted names."),
+    ("field", "The field lay golden and still, waiting for the combine to cross it.",
+     "The acreage lay golden and still, waiting for the combine to cross it."),
+    ("shop", "The shop kept its shutters up late for the bakery next door.",
+     "The store kept its shutters up late for the bakery next door."),
+    ("road", "The road narrowed to a single track as it climbed through the pines.",
