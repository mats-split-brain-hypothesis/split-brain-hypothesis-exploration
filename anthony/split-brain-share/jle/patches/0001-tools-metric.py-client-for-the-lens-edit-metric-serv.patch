+"""Client for the lens-edit metric server (the model runs on the GPU box; this machine only sends requests).
+
+The server holds Qwen3.5-4B and its J-lens, and scores a spectral edit of the lens on the association dev split:
+strict pass@10 and the mean log10 best target rank, read with the edited J-lens at the read layers.
+
+    python tools/metric.py info
+    python tools/metric.py run out/edit/m.pt
+    python tools/metric.py spectrum --out out/edit/svd.pt [--k 256]
+    python tools/metric.py capture spec.json --out out/edit/means.pt
+
+``m.pt`` is ``{layer: tensor[d_model]}``: multipliers on the singular values of ``J_l`` at each listed read layer,
+``J_l' = U diag(m * S) V^T`` with ``J_l = U diag(S) V^T`` and ``S`` in descending order (float64 SVD on the server);
+read layers left out keep ``J_l``. ``spectrum`` returns ``S`` and the top-k singular vectors (``U[:, :k]``,
+``V^T[:k]``) at the read layers. A capture spec is JSON: ``{"layers": [...], "prompts": [{"user": ...,
+"assistant": ...}], "positions": "last" | "user" | "assistant" | "all"}``, or ``{"layers": [...], "bench_items":
+[ids], "family": ..., "split": ...}`` to read a bench bank's own read cells. The server address is
+``JLE_METRIC_URL`` (default ``http://localhost:8765``).
+"""
+
+import argparse
+import base64
+import json
+import os
+import sys
+import urllib.request
+
+import torch
+
+URL = os.environ.get("JLE_METRIC_URL", "http://localhost:8765")
+
+
+def _call(path: str, body: dict | None = None, timeout: float = 900) -> dict:
+    data = None if body is None else json.dumps(body).encode()
+    req = urllib.request.Request(URL + path, data=data, headers={"Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            return json.loads(r.read())
+    except urllib.error.HTTPError as e:
+        raise RuntimeError(json.loads(e.read()).get("error", str(e))) from None
+
+
+def _enc(t: torch.Tensor) -> dict:
+    return {"b64": base64.b64encode(t.detach().float().cpu().contiguous().numpy().tobytes()).decode()}
+
+
+def _dec(x: dict) -> torch.Tensor:
+    t = torch.frombuffer(bytearray(base64.b64decode(x["b64"])), dtype=torch.float32).clone()
+    return t.reshape(x["shape"])
+
+
+def info() -> dict:
+    return _call("/info")
+
+
+def run_metric(multipliers: dict[int, torch.Tensor]) -> dict:
+    """Score the edit ``multipliers`` (read layer -> [d_model]); returns the fit numbers."""
+    return _call("/run_metric", {"multipliers": {str(L): _enc(m) for L, m in multipliers.items()}})
+
+
+def spectrum(layers: list[int] | None = None, k: int = 256) -> dict:
+    """``{"layers", "k", "S": {L: [d]}, "U": {L: [d, k]}, "Vh": {L: [k, d]}}`` at the read layers."""
+    out = _call("/spectrum", {"k": k} | ({"layers": layers} if layers else {}))
+    for key in ("S", "U", "Vh"):
+        out[key] = {int(L): _dec(v) for L, v in out[key].items()}
+    return out
+
+
+def capture(spec: dict) -> dict:
+    """Residual means for a capture spec: ``{"n_prompts", "layers", "mean": {L: [d]}, "per_prompt"?: {L: [n, d]}}``."""
+    out = _call("/capture", spec)
+    for k in ("mean", "per_prompt"):
+        if k in out:
+            out[k] = {int(L): _dec(v) for L, v in out[k].items()}
+    return out
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    sub.add_parser("info")
+    r = sub.add_parser("run")
+    r.add_argument("multipliers")
+    s = sub.add_parser("spectrum")
+    s.add_argument("--out", required=True)
+    s.add_argument("--k", type=int, default=256)
+    s.add_argument("--layers", type=int, nargs="*")
+    c = sub.add_parser("capture")
+    c.add_argument("spec")
+    c.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if a.cmd == "info":
+        print(json.dumps(info(), indent=1))
+    elif a.cmd == "run":
+        mult = {int(L): m for L, m in torch.load(a.multipliers, weights_only=False).items()}
+        print(json.dumps(run_metric(mult), indent=1, ensure_ascii=False))
+    elif a.cmd == "spectrum":
+        out = spectrum(a.layers, a.k)
+        torch.save(out, a.out)
+        print(f"layers {out['layers']}, k {out['k']} -> {a.out}", file=sys.stderr)
+    else:
+        with open(a.spec) as f:
+            out = capture(json.load(f))
+        torch.save(out, a.out)
+        print(f"{out['n_prompts']} prompts, layers {out['layers']} -> {a.out}", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
