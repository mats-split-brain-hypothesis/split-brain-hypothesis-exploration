+"""Submission checks for task jlens-steer-assoc-023 (TASK.md). Run: .venv/bin/python -m pytest eval/test_submission.py -q
+
+These check the submission's form only; they make no scored call. The grader scores it after the time limit.
+"""
+
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+SUB = ROOT / "submission" / "submission.json"
+
+
+@pytest.fixture(scope="module")
+def sub() -> dict:
+    assert SUB.exists(), "no submission: run eval/submit.py"
+    return json.loads(SUB.read_text())
+
+
+def test_fields(sub):
+    for k in ("task_id", "vectors", "vectors_sha256", "positions", "scale", "method", "writeup"):
+        assert k in sub, f"missing {k}"
+    assert sub["positions"] in ("prefix", "read", "context")
+    assert sub["method"].strip()
+
+
+def test_vectors_unchanged(sub):
+    data = (ROOT / sub["vectors"]).read_bytes()
+    assert hashlib.sha256(data).hexdigest() == sub["vectors_sha256"], "vectors changed since submit: submit again"
+
+
+def test_vectors_shape(sub):
+    raw = torch.load(ROOT / sub["vectors"], weights_only=False)
+    assert isinstance(raw, dict) and raw
+    for L, v in raw.items():
+        assert torch.as_tensor(v).numel() == 2560, f"layer {L}: expected 2560 entries"
+
+
+def test_writeup(sub):
+    assert (ROOT / sub["writeup"]).read_text().strip(), "submission.md is empty"
