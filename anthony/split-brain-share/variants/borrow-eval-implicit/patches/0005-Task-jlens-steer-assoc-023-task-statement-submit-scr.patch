--- /dev/null
+++ b/eval/submit.py
@@ -0,0 +1,69 @@
+"""Record a submission for task jlens-steer-assoc-023 (see TASK.md).
+
+    .venv/bin/python eval/submit.py submission/vectors.pt --positions prefix --scale 1.0 \
+        --method "<short name>" --writeup submission/submission.md
+
+Validates the intervention and the write-up and writes `submission/submission.json`. It makes no scored call: the
+grader scores the final submission after the time limit.
+"""
+
+import argparse
+import hashlib
+import json
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+import metric  # noqa: E402
+
+OUT = ROOT / "submission" / "submission.json"
+POSITIONS = ("prefix", "read", "context")
+
+
+def load_vectors(path: Path, d_model: int, n_layers: int) -> dict[int, torch.Tensor]:
+    raw = torch.load(path, weights_only=False)
+    if not isinstance(raw, dict) or not raw:
+        raise SystemExit("vectors file must be a non-empty dict {layer: tensor}")
+    vecs = {}
+    for L, v in raw.items():
+        L = int(L)
+        if not 0 <= L < n_layers - 1:
+            raise SystemExit(f"layer {L} outside 0..{n_layers - 2}")
+        v = torch.as_tensor(v).float().reshape(-1)
+        if v.numel() != d_model:
+            raise SystemExit(f"layer {L}: vector has {v.numel()} entries, expected {d_model}")
+        if not torch.isfinite(v).all():
+            raise SystemExit(f"layer {L}: vector has non-finite entries")
+        vecs[L] = v
+    return vecs
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("vectors")
+    ap.add_argument("--positions", default="prefix", choices=POSITIONS)
+    ap.add_argument("--scale", type=float, default=1.0)
+    ap.add_argument("--method", required=True)
+    ap.add_argument("--writeup", required=True)
+    a = ap.parse_args()
+    info = metric.info()
+    vecs = load_vectors(Path(a.vectors), info["d_model"], info["n_layers"])
+    writeup = Path(a.writeup)
+    if not writeup.exists() or not writeup.read_text().strip():
+        raise SystemExit(f"{writeup} not found or empty")
+    sub = {"task_id": "jlens-steer-assoc-023", "submitted": time.strftime("%Y-%m-%dT%H:%M:%S"),
+           "vectors": str(Path(a.vectors)), "vectors_sha256": hashlib.sha256(Path(a.vectors).read_bytes()).hexdigest(),
+           "layers": sorted(vecs), "positions": a.positions, "scale": a.scale, "method": a.method,
+           "writeup": str(writeup)}
+    OUT.parent.mkdir(exist_ok=True)
+    OUT.write_text(json.dumps(sub, indent=1))
+    print(f"submission recorded: {len(vecs)} layer(s) {sorted(vecs)}, positions {a.positions}, scale {a.scale}. "
+          "The grader scores it on fit after the time limit (score 0 below pass@10 0.40).")
+
+
+if __name__ == "__main__":
+    main()
