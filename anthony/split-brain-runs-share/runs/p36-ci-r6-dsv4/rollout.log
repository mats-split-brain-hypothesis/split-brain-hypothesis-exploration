export function useTheme(): ThemeContextValue {
  const context = useContext(ThemeContext)
  if (context) return context

  // Safe fallback for isolated component usage (for example, a chart rendered
  // directly in a unit test without the dashboard shell). In the app this hook
  // is always used inside <ThemeProvider>, so the fallback is never used.
  const theme: Theme =
    typeof document !== 'undefined' && document.documentElement.dataset.theme === 'dark'
      ? 'dark'
      : 'light'
  return { theme, toggleTheme: () => {} }
}

