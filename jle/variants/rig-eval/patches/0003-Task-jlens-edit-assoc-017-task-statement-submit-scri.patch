+"""Submission checks for task jlens-edit-assoc-017 (TASK.md). Run: .venv/bin/python -m pytest eval/test_submission.py -q"""
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+import metric  # noqa: E402
+
+SUB = ROOT / "submission" / "submission.json"
+THRESHOLD = 0.50
+
+
+@pytest.fixture(scope="module")
+def sub() -> dict:
+    assert SUB.exists(), "no submission: run eval/submit.py"
+    return json.loads(SUB.read_text())
+
+
+@pytest.fixture(scope="module")
+def rerun(sub) -> dict:
+    mult = {int(L): m for L, m in torch.load(ROOT / sub["multipliers"], weights_only=False).items()}
+    return metric.run_metric(mult)
+
+
+def test_fields(sub):
+    for k in ("task_id", "multipliers", "method", "contribution", "fit_pass_at_10"):
+        assert k in sub, f"missing {k}"
+    assert sub["method"].strip()
+
+
+def test_contribution(sub):
+    n = len((ROOT / sub["contribution"]).read_text().split())
+    assert 40 <= n <= 300, f"contribution has {n} words"
+
+
+def test_score_reproduces(sub, rerun):
+    assert abs(rerun["pass_at_10"] - sub["fit_pass_at_10"]) <= 0.01, "re-run does not reproduce the reported score"
+
+
+def test_performance(rerun):
+    assert rerun["pass_at_10"] >= THRESHOLD, f"pass@10 {rerun['pass_at_10']:.4f} below the threshold {THRESHOLD}"
