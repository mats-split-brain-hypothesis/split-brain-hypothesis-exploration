@@ -0,0 +1,69 @@
+"""Record a submission for task jlens-edit-assoc-017 (see TASK.md).
+
+    .venv/bin/python eval/submit.py submission/multipliers.pt \
+        --method "<short name>" --contribution submission/contribution.md
+
+Validates the edit, scores it on `fit` through the metric server and writes `submission/submission.json`.
+"""
+
+import argparse
+import hashlib
+import json
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+import metric  # noqa: E402
+
+OUT = ROOT / "submission" / "submission.json"
+
+
+def load_multipliers(path: Path, d_model: int, read_layers: list[int]) -> dict[int, torch.Tensor]:
+    raw = torch.load(path, weights_only=False)
+    if not isinstance(raw, dict) or not raw:
+        raise SystemExit("multipliers file must be a non-empty dict {layer: tensor}")
+    mult = {}
+    for L, m in raw.items():
+        L = int(L)
+        if L not in read_layers:
+            raise SystemExit(f"layer {L} is not a read layer {read_layers}")
+        m = torch.as_tensor(m).float().reshape(-1)
+        if m.numel() != d_model:
+            raise SystemExit(f"layer {L}: multipliers have {m.numel()} entries, expected {d_model}")
+        mult[L] = m
+    return mult
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("multipliers")
+    ap.add_argument("--method", required=True)
+    ap.add_argument("--contribution", required=True)
+    a = ap.parse_args()
+    info = metric.info()
+    mult = load_multipliers(Path(a.multipliers), info["d_model"], info["read_layers"])
+    contrib = Path(a.contribution)
+    if not contrib.exists():
+        raise SystemExit(f"{contrib} not found")
+    n_words = len(contrib.read_text().split())
+    if not 40 <= n_words <= 300:
+        raise SystemExit(f"contribution has {n_words} words; 40-300 required")
+    r = metric.run_metric(mult)
+    sub = {"task_id": "jlens-edit-assoc-017", "submitted": time.strftime("%Y-%m-%dT%H:%M:%S"),
+           "multipliers": str(Path(a.multipliers)),
+           "multipliers_sha256": hashlib.sha256(Path(a.multipliers).read_bytes()).hexdigest(),
+           "layers": sorted(mult), "method": a.method,
+           "contribution": str(contrib), "fit_pass_at_10": r["pass_at_10"], "fit_mean_log10_rank": r["mean_log10_rank"],
+           "baseline": r["baseline"]}
+    OUT.parent.mkdir(exist_ok=True)
+    OUT.write_text(json.dumps(sub, indent=1))
+    print(f"submission recorded: fit pass@10 {r['pass_at_10']:.4f} (baseline {r['baseline']['pass_at_10']:.4f}); "
+          f"pass threshold 0.50 -> {'PASS' if r['pass_at_10'] >= 0.5 else 'below threshold (scores 0)'}")
+
+
+if __name__ == "__main__":
+    main()
